# Copy to .env; use your restricted role's Supabase SESSION pooler URL.
APP_ENV=dev
DB_SCHEMA=dev
DATABASE_URL=postgresql+psycopg://expense_dev_app.uespfuwurianxwopguwa:REPLACE@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
# Runtime role cannot run migrations. Set only in your trusted migration terminal:
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:REPLACE@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ALLOW_REGISTRATION=true
UPDATES_GITHUB_REPOSITORY=Dharaneesh-23/mobile-expense-tracker
# Separate fine-grained PAT: only this repository, Contents READ. Never put it in an APK.
UPDATES_GITHUB_TOKEN=
# For QA use APP_ENV=qa, DB_SCHEMA=qa, and expense_qa_app.PROJECT_REF as the pooler username.
# Supabase shared pooler custom-role usernames are ROLE.PROJECT_REF, not just ROLE.
